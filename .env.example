# Copy to .env (git-ignored, never committed). The CLI and the server load it at boot
# (process.loadEnvFile). Shell variables take the same names. Every entry is optional.

# Google Books key for the book cover lookup (GET /api/manga-lookup, server only).
# Must be a Google CLOUD API key (starts with "AIza"). An AI-Studio/Gemini key ("AQ.…") is rejected (401).
# Empty = the English-edition lookup is skipped; AniList/Jikan still work.
# Create one: console.cloud.google.com → your project → enable "Books API" → Credentials → Create API key.
# You can also set the key in the app (ARCHIVES, "Google Books API key") instead of here; if both are set, this one wins.
# GOOGLE_BOOKS_API_KEY=

# SQLite file for the CLI and the server. Default: data/solace.sqlite under the working directory
# (the repo root when run via npm). That is the LIVE DB: any CLI command or server boot migrates it.
# For experiments, point this at a scratch copy: SOLACE_DB=$(mktemp -d)/t.sqlite
# SOLACE_DB=

# API server port. Default: 8787. Server only (backend/server/src/index.ts).
# PORT=8787

# API server bind address. Default: 127.0.0.1. The write API has no auth; 0.0.0.0 exposes it on the LAN.
# Server only (backend/server/src/index.ts).
# HOST=127.0.0.1

# Path to the uv binary used by the Garmin sync. Default: /opt/homebrew/bin/uv if it exists, else `uv` on PATH.
# Used by the Garmin sync (backend/data/src/garmin-sync.ts).
# SOLACE_UV_BIN=/opt/homebrew/bin/uv

# Mac app only (desktop/): port of the web UI the app starts or reuses. Default: 5174. The app reads PORT for the API.
# SOLACE_WEB_PORT=5174

# Mac app only (desktop/): Client ID of your Spotify developer app, for the desk radio's Spotify mode (Premium needed).
# No secret. Register the redirect URI http://127.0.0.1:<web port>/spotify-callback (default http://127.0.0.1:5174/spotify-callback).
# Without it the radio plays the local lofi tracks. Setup: README "Desk radio".
# SOLACE_SPOTIFY_CLIENT_ID=

# Dev only: where the Vite /api proxy forwards requests. Default: http://localhost:8787.
# Read by frontend/vite.config.ts from the shell environment, not from .env. Used for scratch-server checks.
# SOLACE_API=http://localhost:8787

# Desk sky (day/night + weather mood): the server asks Open-Meteo (free, no key) for sunrise, sunset and the current
# weather at this location, at most once per 30 minutes. Decimal degrees; set both. Default: Antwerp (51.22, 4.40).
# The demo always uses the default. Server only (backend/server/src/index.ts).
# SOLACE_LAT=51.22
# SOLACE_LON=4.40

# SOLACE_SKY=0 turns that lookup off: no request is made and the desk follows fixed clock hours.
# SOLACE_SKY=0

# Price table for volume estimates. Default: source-exports/price-table.json if it exists, else config/price-table.example.json.
# SOLACE_PRICE_TABLE=source-exports/price-table.json
